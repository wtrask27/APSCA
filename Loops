package com.mycompany.loops;

/**
 *
 * @author wtrask2027
 */
public class Loops {
    public static void main(String[] args) {

        // Pattern a
        System.out.println("a.");
        for (int row = 10; row >= 1; row--) {
            for (int star = 1; star <= row; star++) {
                System.out.print("*");
            }
            System.out.println();
        }

        // Pattern b
        System.out.println("\nb.");
        for (int row = 1; row <= 10; row++) {
            for (int space = 1; space <= 10 - row; space++) {
                System.out.print(" ");
            }
            for (int star = 1; star <= row; star++) {
                System.out.print("*");
            }
            System.out.println();
        }

        // Pattern c
        System.out.println("\nc.");
        for (int row = 10; row >= 1; row--) {
            for (int space = 1; space <= 10 - row; space++) {
                System.out.print(" ");
            }
            for (int star = 1; star <= row; star++) {
                System.out.print("*");
            }
            System.out.println();
        }

        // Pattern d: top half
        System.out.println("\nd.");
        for (int row = 1; row <= 5; row++) {
            for (int space = 1; space <= 5 - row; space++) {
                System.out.print(" ");
            }
            for (int star = 1; star <= 2 * row - 1; star++) {
                System.out.print("*");
            }
            System.out.println();
        }

        // Pattern d: bottom half
        for (int row = 5; row >= 1; row--) {
            for (int space = 1; space <= 5 - row; space++) {
                System.out.print(" ");
            }
            for (int star = 1; star <= 2 * row - 1; star++) {
                System.out.print("*");
            }
            System.out.println();
        }
    }
}
