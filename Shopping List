package com.mycompany.shoppinglist;

import java.util.ArrayList;
import java.util.Scanner;

public class ShoppingList {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        ArrayList<Item> items = new ArrayList<Item>();

        System.out.println("Carrots: $2, Corn: $1, Bread: $3");

        // Add items using fixed prices
        while (true) {
            System.out.print("Enter an item or done: ");
            String name = input.nextLine().trim().toLowerCase();
            double price = 0;

            if (name.equals("done")) {
                break;
            } else if (name.equals("carrots")) {
                price = 2;
            } else if (name.equals("corn")) {
                price = 1;
            } else if (name.equals("bread")) {
                price = 3;
            } else {
                System.out.println("That item is not available.");
                continue;
            }

            items.add(new Item(name, price));
            System.out.println("Added " + name + " for $" + price);
        }

        // Show the list and let the user remove items
        displayList(items);
        while (items.size() > 0) {
            System.out.print("Number to remove, or 0 to finish: ");
            int number = input.nextInt();

            if (number == 0) {
                break;
            }
            if (number < 1) {
                System.out.println("Invalid number.");
            } else if (number > items.size()) {
                System.out.println("Invalid number.");
            } else {
                items.remove(number - 1);
                displayList(items);
            }
        }
        input.close();
    }

    public static void displayList(ArrayList<Item> items) {
        double total = 0;
        System.out.println("Shopping List:");

        for (int i = 0; i < items.size(); i = i + 1) {
            Item item = items.get(i);
            System.out.println((i + 1) + ". " + item.name + " - $" + item.price);
            total = total + item.price;
        }
        System.out.println("Total: $" + total);
    }
}

class Item {
    String name;
    double price;

    public Item(String itemName, double itemPrice) {
        name = itemName;
        price = itemPrice;
    }
}
