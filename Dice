package com.mycompany.stringproject;

import java.util.Scanner;

public class Dice {

    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);  // Reads the user's input
        String choice = "r";                     // Makes the die roll once to start

        while (choice.equalsIgnoreCase("r")) {   // Repeats when the user types r

            int roll = (int) (Math.random() * 6) + 1;  // Random number from 1 to 6

            System.out.println("You rolled a " + roll); // Displays the roll

            System.out.print("Type r to roll again: "); // Asks to roll again
            choice = input.nextLine();                  // Saves the user's answer
        }

        System.out.println("Thanks for playing!"); // Runs when the loop ends
        input.close();                             // Closes the Scanner
    }
}
