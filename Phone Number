import java.util.Random;
import java.util.Scanner;

public class RandomPhone {

    public static void main(String[] args) {

        Random generator = new Random();
        Scanner keyboard = new Scanner(System.in);

        String choice = "p";

        while (choice.equalsIgnoreCase("p")) {

            // Each digit in the first section can only be 0–7
            int firstDigit = generator.nextInt(8);
            int secondDigit = generator.nextInt(8);
            int thirdDigit = generator.nextInt(8);

            // The middle section can be from 000–655
            int middleSection = generator.nextInt(656);

            // The last section can be from 0000–9999
            int lastSection = generator.nextInt(10000);

            System.out.printf(
                "Random phone number: %d%d%d-%03d-%04d%n",
                firstDigit,
                secondDigit,
                thirdDigit,
                middleSection,
                lastSection
            );

            System.out.print(
                "Enter \"p\" to generate another phone number, "
                + "or any other letter to stop: "
            );

            choice = keyboard.nextLine();
        }

        System.out.println("Phone number generator ended.");
        keyboard.close();
    }
}
