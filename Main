public class Main {
    public static void main(String[] args) {
        Car vwBug = new Car();
        vwBug.setCarBrand("VW Bug");
        vwBug.setEnginePower(150);
        vwBug.setCarSpeed(120.0);
        vwBug.setPrice(22000.0);

        Car prius = new Car();
        prius.setCarBrand("Toyota Prius");
        prius.setEnginePower(140);
        prius.setCarSpeed(115.0);
        prius.setPrice(28000.0);

        Car bmw = new Car();
        bmw.setCarBrand("BMW i8");
        bmw.setEnginePower(370);
        bmw.setCarSpeed(155.0);
        bmw.setPrice(140000.0);

        Car tesla = new Car();
        tesla.setCarBrand("Tesla Model 3");
        tesla.setEnginePower(280);
        tesla.setCarSpeed(140.0);
        tesla.setPrice(40000.0);

        // Passing each object to println calls its toString method
        System.out.println(vwBug);
        System.out.println();

        System.out.println(prius);
        System.out.println();

        System.out.println(bmw);
        System.out.println();

        System.out.println(tesla);
    }
}
